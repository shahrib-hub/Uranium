# ========================================================
# Uranium Bot — Environment Configuration
# ========================================================

# ---------- Discord Bot Credentials ----------
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# ---------- Dashboard & Web Backend Configuration ----------
# The public Vercel frontend URL (must NOT have a trailing slash)
# Must match your Discord Developer Portal OAuth2 Redirect: https://uraniumbot.vercel.app/auth/callback
DASHBOARD_URL=https://uraniumbot.vercel.app

# Port allocated by your host (VisiHost allocated port: 25634)
DASHBOARD_PORT=25634
DASHBOARD_HOST=0.0.0.0

# Session encryption secret (generate a strong random string)
SESSION_SECRET=uranium_super_secure_random_session_secret_change_me

# ---------- Database (MongoDB Atlas) ----------
USE_MONGODB=true
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/multibot?retryWrites=true&w=majority
MONGODB_TIMEOUT_MS=15000
# Force IPv4 if VisiHost node experiences IPv6 DNS timeouts to MongoDB Atlas:
MONGODB_FORCE_IPV4=true

# ---------- Lavalink Music Configuration ----------
LAVALINK_HOST=your_lavalink_host
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false
DEFAULT_SOURCE=ytmsearch:

# ---------- Bot & Developer Settings ----------
DEV_GUILD_ID=your_development_guild_id
BOT_OWNER_IDS=your_discord_user_id
SUPPORT_SERVER_URL=https://discord.gg/26ThFyckFX

# ---------- Optional Integrations ----------
# Twitch Stream Notifications
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Groq AI Commands
GROQ_API_KEY=
