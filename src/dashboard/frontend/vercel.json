{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/auth/(.*)",
      "destination": "http://noida.visihost.in:25634/auth/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "http://noida.visihost.in:25634/api/$1"
    },
    {
      "source": "/socket.io/(.*)",
      "destination": "http://noida.visihost.in:25634/socket.io/$1"
    }
  ]
}
