{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/auth/login",
      "destination": "https://uraniumbot.wisp.uno/auth/login"
    },
    {
      "source": "/auth/login/",
      "destination": "https://uraniumbot.wisp.uno/auth/login"
    },
    {
      "source": "/auth/callback",
      "destination": "https://uraniumbot.wisp.uno/auth/callback"
    },
    {
      "source": "/auth/callback/",
      "destination": "https://uraniumbot.wisp.uno/auth/callback"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://uraniumbot.wisp.uno/auth/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://uraniumbot.wisp.uno/api/:path*"
    }
  ]
}
